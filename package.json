{
  "name": "homeflow-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "./node_modules/.bin/esbuild server/app.ts --bundle --platform=node --format=esm --target=node22 --outfile=api/v1/_server.mjs --external:node:* && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "api:dev": "tsx server/dev.ts",
    "api:typecheck": "tsc --noEmit -p tsconfig.server.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "api:bundle": "esbuild server/app.ts --bundle --platform=node --format=esm --target=node22 --outfile=api/v1/_server.mjs --external:node:*"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@vitejs/plugin-react": "4.7.0",
    "decimal.js": "10.6.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "hono": "^4.13.21",
    "jose": "^6.2.18",
    "lucide-react": "0.468.0",
    "postgres": "^4.1.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.9.4",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.12",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "prettier": "3.6.2",
    "tsx": "^4.23.15",
    "vitest": "3.2.4"
  }
}
